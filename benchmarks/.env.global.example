# benchmarks/.env.global.example — Layer 0 全局共享配置模板
#
# 用途：
#   此文件是所有 benchmark 的最低优先级配置层（Layer 0）。
#   将此文件复制为 benchmarks/.env.global 并填写真实 API key 后，
#   所有 benchmark（financebench、hotpotqa 等）将自动继承这些配置，
#   无需在每个 benchmark 的 .env 文件中重复填写。
#
# 优先级（从低到高）：
#   .env.global  →  .env.financebench / .env.hotpotqa  →  os.environ
#   即：benchmark 专属 .env 中的同名 key 会覆盖此文件的值。
#
# 何时应修改此文件：
#   - 切换 LLM 提供商（如从 DashScope 换到 OpenAI）
#   - 更新共享 API key
#   - 修改 Embedding 模型
#
# ⚠️  Layer 0 变更提醒：
#   此文件中的任何变更都属于 Layer 0 GLOBAL 变更，将影响所有 benchmark。
#   如使用 run_research_loop.py，ImprovementAdvisor 会自动标注并提示。

# ===== LLM 设置（全局共享） =====
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# 各 benchmark 可在自己的 .env 文件中用 LLM_MODEL_NAME 覆盖此值
LLM_MODEL_NAME=qwen3.5-plus
LLM_TIMEOUT=120

# ===== Embedding 设置（可选，全局共享） =====
# 若不填，各 benchmark 使用默认值
# EMBEDDING_MODEL_ID=
# EMBEDDING_CACHE_DIR=~/.sirchmunk/models
