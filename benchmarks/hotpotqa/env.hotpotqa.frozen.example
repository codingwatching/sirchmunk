# ===== HotpotQA Frozen Evaluation Profile Example =====
# Copy this file to benchmarks/hotpotqa/.env.hotpotqa.frozen.
# Requires benchmarks/hotpotqa/.env.hotpotqa.base for shared HotpotQA settings.
# Use this profile for paper-grade frozen evaluation only.

HOTPOT_OUTPUT_DIR=./output/frozen
HOTPOT_LIMIT=0

# Official EM/F1 must be the primary paper metrics. Keep LLM judge disabled for the main table.
HOTPOT_ENABLE_LLM_JUDGE=false
ALLOW_FROZEN_LLM_JUDGE_AUXILIARY=false
HOTPOT_ENABLE_GPT_EVAL=false

HOTPOT_CACHE_MODE=cold
HOTPOT_MAX_CONCURRENT=1
HOTPOT_REQUEST_DELAY=0.5
BENCHMARK_TIMEOUT_SECONDS=172800
