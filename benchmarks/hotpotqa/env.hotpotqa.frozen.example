# ===== HotpotQA Frozen Evaluation Profile Example =====
# Copy this file to benchmarks/hotpotqa/.env.hotpotqa.frozen.
# Requires benchmarks/hotpotqa/.env.hotpotqa.base for shared HotpotQA settings.
# Use this profile for paper-grade frozen evaluation only.
# Loading order: benchmarks/.env.global < .env.hotpotqa.base < profile env < os.environ.

# ===== Output / Stage =====
HOTPOT_OUTPUT_DIR=./output/frozen

# Frozen evaluation should be defined by a full split, a frozen GoldenSet, or
# fixed sample IDs. Keep this at 0 so ad hoc random limits do not define paper
# claims.
HOTPOT_LIMIT=0

# ===== Sampling Configuration =====
# Optional for direct frozen runs with run_evaluation.py / run_queue.py.
# If set, HotpotQAAdapter loads exactly these sample IDs in file order and
# ignores HOTPOT_LIMIT.
#
# Recommended direct workflow:
#   python benchmarks/run_sampling.py create \
#     --benchmark hotpotqa \
#     --env benchmarks/hotpotqa/.env.hotpotqa.frozen \
#     --method stratified \
#     --target-n 2000 \
#     --seed 42 \
#     --strata type,supporting_fact_bucket
#
# Then either set this field to the generated sampling_*_sample_ids.json, or
# pass --sample-ids-file to run_evaluation.py.
#
# For v4 dynamic G_n/D_n evaluation, leave this empty. run_dynamic_evaluation.py
# derives G_500/G_1000/G_2000 and injects per-stage sample IDs through
# stage_bindings.json.
HOTPOT_SAMPLE_IDS_FILE=

# ===== Corpus Mode =====
# Frozen fullwiki/paper runs must search the configured raw wiki corpus or a
# v4 D_n/documents snapshot. Do not use sample/hybrid oracle-context modes in
# main paper tables.
HOTPOT_CONTEXT_CORPUS_MODE=wiki
HOTPOT_REQUIRE_CONTEXT_ANSWERABLE=false

# v4 dynamic evaluation note:
#   run_dynamic_evaluation.py overrides HOTPOT_WIKI_CORPUS_DIR per stage so
#   each run searches D_n/documents rather than the static fullwiki root.
#   Do not hardcode D_n paths in this frozen profile.

# ===== Judge / Auxiliary Evaluation =====
# Official EM/F1 must be the primary paper metrics. Keep LLM judge disabled for
# the main table unless the run is explicitly marked auxiliary.
HOTPOT_ENABLE_LLM_JUDGE=false
ALLOW_FROZEN_LLM_JUDGE_AUXILIARY=false
HOTPOT_ENABLE_GPT_EVAL=false

# ===== Memory / Feedback Isolation =====
# Frozen evaluation must not adapt from test-set feedback.
HOTPOT_ENABLE_EVAL_FEEDBACK=false
SIRCHMUNK_ENABLE_MEMORY=false
HOTPOT_REUSE_KNOWLEDGE=false

# ===== Cache / Concurrency =====
# Frozen evaluation accepts cold or compiled cache modes. Use cold as the default
# for paper claims unless a compiled artifact is explicitly versioned.
HOTPOT_CACHE_MODE=cold
# Applies to the LENS sample-level concurrency and to how many baseline systems
# are evaluated at once. It does NOT change per-sample concurrency inside a single
# baseline: each BaselineAdapter declares that itself and defaults to serial, which
# keeps API rate limits and reported latency comparable across systems.
HOTPOT_MAX_CONCURRENT=5
HOTPOT_REQUEST_DELAY=0.5
# Per-sample concurrency inside a single baseline. 0 = keep each BaselineAdapter's
# own declaration (normally serial). Raising it cuts wall clock for multi-turn LLM
# baselines such as ReAct by roughly the same factor, at two costs: latency becomes
# measured under contention (recorded per result as measured_sample_concurrency),
# and slow samples can cross SAMPLE_TIMEOUT_SECONDS and count as failures. Raise
# gradually and check failure counts. Baselines declaring
# supports_query_concurrency() -> False (LightRAG) stay serial regardless.
HOTPOT_BASELINE_SAMPLE_CONCURRENT=0

# ===== Runtime Guards =====
# SAMPLE_TIMEOUT_SECONDS applies to each question. BENCHMARK_TIMEOUT_SECONDS is
# the whole benchmark cap. Leave 0 for unlimited budgets only when the enclosing
# runner already declares resource limits.
SAMPLE_TIMEOUT_SECONDS=300
SYSTEM_TIMEOUT_SECONDS=0
BENCHMARK_TIMEOUT_SECONDS=172800
GLOBAL_TIMEOUT_SECONDS=0
MAX_RUNTIME_SECONDS=0
MAX_TOTAL_TOKENS=0
MAX_API_COST_USD=0
MAX_DISK_USAGE_BYTES=0
MIN_FREE_DISK_BYTES=0

# ===== Related-work Baseline Notes =====
# LightRAG v1.3.6 is an optional lifecycle baseline. Keep its experiment knobs
# in CLI arguments so each run records them explicitly:
#   --lightrag-query-mode naive|local|global|hybrid|mix
#   --lightrag-working-dir <path>
#   --lightrag-max-files <N>
#   --lightrag-max-file-chars <N>
