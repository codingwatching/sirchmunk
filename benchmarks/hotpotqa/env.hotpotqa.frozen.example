# ===== HotpotQA Frozen Evaluation Configuration Example =====
# Copy to a private .env file for paper-grade frozen evaluation.
# Do not store secrets in tracked files. Set LLM_API_KEY in your shell/private env.

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=...
LLM_MODEL_NAME=qwen3.5-plus
LLM_TIMEOUT=120

HOTPOT_DATASET_DIR=/Users/jason/work/github/sirchmunk_work/data/hotpotqa_dataset/
HOTPOT_WIKI_CORPUS_DIRNAME=enwiki-20171001-pages-meta-current-withlinks-abstracts
HOTPOT_OUTPUT_DIR=./output/frozen

HOTPOT_SETTING=fullwiki
HOTPOT_SPLIT=validation
HOTPOT_LIMIT=0
HOTPOT_SEED=42

HOTPOT_MODE=DEEP
HOTPOT_ENABLE_CROSS_LINGUAL=false
HOTPOT_TOP_K_FILES=10
HOTPOT_MAX_TOKEN_BUDGET=128000
HOTPOT_ENABLE_DIR_SCAN=true
HOTPOT_RGA_MAX_COUNT=50
HOTPOT_UGREP_CORPUS_PATH=/Users/jason/work/github/sirchmunk_work/data/hotpotqa_dataset/enwiki-20171001-pages-meta-current-withlinks-abstracts
HOTPOT_HIGHFREQ_FILE_THRESHOLD=500
HOTPOT_RGA_MAX_PARSE_LINES=50000
HOTPOT_MERGE_MAX_FILES=500

SIRCHMUNK_ENABLE_MEMORY=false
HOTPOT_ENABLE_EVAL_FEEDBACK=false
HOTPOT_REUSE_KNOWLEDGE=false
HOTPOT_SP_HEURISTIC_ONLY=0
HOTPOT_EXTRACT_ANSWER=true
HOTPOT_ENABLE_REFLECTION=false
HOTPOT_ENABLE_LLM_JUDGE=false
HOTPOT_JUDGE_F1_THRESHOLD=0.3
HOTPOT_ENABLE_GPT_EVAL=false
SIRCHMUNK_ENABLE_THINKING=false

HOTPOT_CACHE_MODE=cold
HOTPOT_MAX_CONCURRENT=1
HOTPOT_REQUEST_DELAY=0.5

SAMPLE_TIMEOUT_SECONDS=300
BENCHMARK_TIMEOUT_SECONDS=172800
MAX_RUNTIME_SECONDS=0
MAX_TOTAL_TOKENS=0
MAX_API_COST_USD=0
