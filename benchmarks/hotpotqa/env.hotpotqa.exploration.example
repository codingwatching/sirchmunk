# ===== HotpotQA Exploration Profile Example =====
# Copy this file to benchmarks/hotpotqa/.env.hotpotqa.exploration.
# Requires benchmarks/hotpotqa/.env.hotpotqa.base for shared HotpotQA settings.
# Use this profile for smoke/pilot runs and candidate configuration checks only.
# Do not use exploration artifacts as final paper claims.
# Loading order: benchmarks/.env.global < .env.hotpotqa.base < profile env < os.environ.

# ===== Output / Sample Limit =====
HOTPOT_OUTPUT_DIR=./output/exploration
HOTPOT_LIMIT=10

# ===== Corpus Mode =====
# Quickstart/exploration smoke runs use the parquet-provided HotpotQA context
# as a per-sample raw-text corpus and sample answerable contexts only. Frozen
# fullwiki runs should use HOTPOT_CONTEXT_CORPUS_MODE=wiki instead.
HOTPOT_CONTEXT_CORPUS_MODE=sample
HOTPOT_REQUIRE_CONTEXT_ANSWERABLE=true

# ===== Judge / Diagnostics =====
# Exploration may enable semantic diagnostics. Official EM/F1 remain primary metrics.
HOTPOT_ENABLE_LLM_JUDGE=true
HOTPOT_ENABLE_GPT_EVAL=true
ALLOW_FROZEN_LLM_JUDGE_AUXILIARY=false

# ===== Memory / Feedback =====
# Exploration may inspect badcases, but do not enable eval feedback unless the
# experiment explicitly studies adaptive behavior.
HOTPOT_ENABLE_EVAL_FEEDBACK=false
SIRCHMUNK_ENABLE_MEMORY=false
HOTPOT_REUSE_KNOWLEDGE=false

# ===== Cache / Concurrency =====
HOTPOT_CACHE_MODE=warm
# Applies to the LENS sample-level concurrency and to how many baseline systems
# are evaluated at once, not to per-sample concurrency inside a single baseline.
HOTPOT_MAX_CONCURRENT=2
HOTPOT_REQUEST_DELAY=0.5
# Per-sample concurrency inside a single baseline. 0 = keep each BaselineAdapter's
# own declaration (normally serial). See the frozen profile for the trade-offs.
HOTPOT_BASELINE_SAMPLE_CONCURRENT=0

# ===== Runtime Guards =====
SAMPLE_TIMEOUT_SECONDS=300
SYSTEM_TIMEOUT_SECONDS=0
BENCHMARK_TIMEOUT_SECONDS=21600
GLOBAL_TIMEOUT_SECONDS=0
MAX_RUNTIME_SECONDS=0
MAX_TOTAL_TOKENS=0
MAX_API_COST_USD=0
MAX_DISK_USAGE_BYTES=0
MIN_FREE_DISK_BYTES=0
