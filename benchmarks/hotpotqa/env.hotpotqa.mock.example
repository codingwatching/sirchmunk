# ===== HotpotQA Mock Smoke Profile Example =====
# Copy this file to benchmarks/hotpotqa/.env.hotpotqa.mock.
# Requires benchmarks/hotpotqa/.env.hotpotqa.base for shared HotpotQA settings.
# This profile uses a deterministic local mock LLM and does NOT call external APIs.
# It is only for pipeline smoke tests, not for paper claims.

HOTPOT_MOCK_LLM=true
HOTPOT_OUTPUT_DIR=./output/mock
HOTPOT_LIMIT=10

# FAST keeps smoke runs short while exercising runner/retrieval/judge/artifact flow.
HOTPOT_MODE=FAST
HOTPOT_TOP_K_FILES=3
HOTPOT_MAX_TOKEN_BUDGET=64000
HOTPOT_ENABLE_DIR_SCAN=false

HOTPOT_ENABLE_LLM_JUDGE=false
HOTPOT_ENABLE_GPT_EVAL=false
HOTPOT_ENABLE_EVAL_FEEDBACK=false
HOTPOT_REUSE_KNOWLEDGE=false
HOTPOT_CACHE_MODE=cold

HOTPOT_MAX_CONCURRENT=1
HOTPOT_REQUEST_DELAY=0.0
SAMPLE_TIMEOUT_SECONDS=60
BENCHMARK_TIMEOUT_SECONDS=1200
