# ===== HotpotQA Base Configuration Example =====
# Copy this file to benchmarks/hotpotqa/.env.hotpotqa.base.
# This layer contains HotpotQA settings shared by exploration and frozen profiles.
# Loading order: benchmarks/.env.global < .env.hotpotqa.base < profile env < os.environ.
# Do not store secrets here. Put LLM_API_KEY in ignored benchmarks/.env.global; use shell env only for temporary overrides.

# ===== Dataset Paths =====
HOTPOT_DATASET_DIR=/path/to/hotpotqa_dataset/fullwiki
HOTPOT_WIKI_CORPUS_DIRNAME=enwiki-20171001-pages-meta-current-withlinks-abstracts
HOTPOT_WIKI_CORPUS_DIR=/path/to/hotpotqa_dataset/enwiki-20171001-pages-meta-current-withlinks-abstracts
HOTPOT_UGREP_CORPUS_PATH=/path/to/hotpotqa_dataset/enwiki-20171001-pages-meta-current-withlinks-abstracts

# ===== Dataset Settings =====
HOTPOT_SETTING=fullwiki
HOTPOT_SPLIT=validation
HOTPOT_SEED=42
# Optional: fixed sample IDs generated by run_sampling.py for paper sampled evaluation.
# When set, HotpotQAAdapter ignores random limit and loads exactly these IDs in file order.
# Supports absolute paths, paths relative to benchmarks/hotpotqa, or paths relative to the project root.
HOTPOT_SAMPLE_IDS_FILE=

# ===== Search Settings =====
HOTPOT_MODE=DEEP
HOTPOT_ENABLE_CROSS_LINGUAL=false
HOTPOT_TOP_K_FILES=10
HOTPOT_MAX_TOKEN_BUDGET=128000
HOTPOT_ENABLE_DIR_SCAN=true
HOTPOT_CONTEXT_CORPUS_MODE=wiki
HOTPOT_RGA_MAX_COUNT=50
HOTPOT_HIGHFREQ_FILE_THRESHOLD=500
HOTPOT_RGA_MAX_PARSE_LINES=50000
HOTPOT_MERGE_MAX_FILES=500

# ===== Memory / Feedback Settings =====
SIRCHMUNK_ENABLE_MEMORY=false
HOTPOT_ENABLE_EVAL_FEEDBACK=false
HOTPOT_REUSE_KNOWLEDGE=false

# ===== LLM / Judge Settings =====
# Required when HOTPOT_ENABLE_LLM_JUDGE=true; base URL and API key come from benchmarks/.env.global.
HOTPOT_JUDGE_MODEL_NAME=qwen3.7-max

# ===== Answer / Evidence Processing =====
HOTPOT_SP_HEURISTIC_ONLY=0
HOTPOT_EXTRACT_ANSWER=true
HOTPOT_ENABLE_REFLECTION=false
HOTPOT_JUDGE_F1_THRESHOLD=0.3
SIRCHMUNK_ENABLE_THINKING=false

# ===== Common Guards =====
SAMPLE_TIMEOUT_SECONDS=300
MAX_RUNTIME_SECONDS=0
MAX_TOTAL_TOKENS=0
MAX_API_COST_USD=0
MAX_DISK_USAGE_BYTES=0
MIN_FREE_DISK_BYTES=0
